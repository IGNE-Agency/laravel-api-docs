{
    "name": "igne-agency/laravel-scramble-extensions",
    "description": "Scramble extensions for any Laravel API: the errors of middleware and of the methods an action calls, and named schemas for paginated lists.",
    "type": "library",
    "license": "MIT",
    "require": {
        "php": "^8.4",
        "dedoc/scramble": "^0.13.52",
        "illuminate/routing": "^12.0|^13.0",
        "illuminate/support": "^12.0|^13.0"
    },
    "require-dev": {
        "orchestra/testbench": "^10.0|^11.0",
        "pestphp/pest": "^4.0",
        "pestphp/pest-plugin-laravel": "^4.0"
    },
    "autoload": {
        "psr-4": {
            "Igne\\ScrambleExtensions\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Igne\\ScrambleExtensions\\Tests\\": "tests/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "Igne\\ScrambleExtensions\\ScrambleExtensionsServiceProvider"
            ]
        }
    },
    "scripts": {
        "test": "pest"
    },
    "config": {
        "sort-packages": true,
        "allow-plugins": {
            "pestphp/pest-plugin": true
        }
    },
    "minimum-stability": "stable"
}
