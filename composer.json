{
    "name": "igne-agency/laravel-api-docs",
    "description": "Scramble extensions for any Laravel API: the errors of middleware and of the methods an action calls, and named schemas for paginated lists.",
    "type": "library",
    "license": "MIT",
    "require": {
        "php": "^8.4",
        "dedoc/scramble": "^0.13.52",
        "illuminate/routing": "^12.0|^13.0",
        "illuminate/support": "^12.0|^13.0"
    },
    "require-dev": {
        "igne-agency/laravel-auth": "dev-test/independent-packages",
        "orchestra/testbench": "^10.0|^11.0",
        "pestphp/pest": "^4.0",
        "pestphp/pest-plugin-laravel": "^4.0"
    },
    "autoload": {
        "psr-4": {
            "Igne\\ApiDocs\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Igne\\ApiDocs\\Tests\\": "tests/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "Igne\\ApiDocs\\ApiDocsServiceProvider"
            ]
        }
    },
    "scripts": {
        "test": "pest"
    },
    "config": {
        "sort-packages": true,
        "allow-plugins": {
            "pestphp/pest-plugin": true
        }
    },
    "minimum-stability": "stable",
    "repositories": [
        {
            "type": "vcs",
            "url": "https://github.com/IGNE-Agency/laravel-auth"
        }
    ]
}
